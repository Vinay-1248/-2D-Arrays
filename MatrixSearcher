public class MatrixSearcher {
    
    public boolean searchMatrix(int[][] matrix, int target) {
        // Base case: empty matrix
        if (matrix == null || matrix.length == 0 || matrix[0].length == 0) {
            return false;
        }
        
        int rows = matrix.length;
        int cols = matrix[0].length;
        
        // Brute force nested loops
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                if (matrix[i][j] == target) {
                    return true; // Target found
                }
            }
        }
        
        return false; // Target not found after checking all elements
    }

    public static void main(String[] args) {
        MatrixSearcher searcher = new MatrixSearcher();
        
        int[][] matrix = {
            {1,   4,  7, 11, 15},
            {2,   5,  8, 12, 19},
            {3,   6,  9, 16, 22},
            {10, 13, 14, 17, 24},
            {18, 21, 23, 26, 30}
        };
        
        int target1 = 5;
        System.out.println("Search for " + target1 + ": " + searcher.searchMatrix(matrix, target1)); 
        // Output: true
        
        int target2 = 20;
        System.out.println("Search for " + target2 + ": " + searcher.searchMatrix(matrix, target2)); 
        // Output: false
    }
}
